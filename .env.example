# Template di configurazione: copiare in `.env` e compilare.
# MAI committare `.env`. Nessun valore reale in questo file (R11).

# Provider: Google Gemini | OpenAI | DeepSeek | Anthropic Claude | Custom OpenAI-Compatible
PDFBOOK_PROVIDER=DeepSeek

# Modello; se vuoto si usa il default del provider
PDFBOOK_MODEL=deepseek-chat

# Chiave API (preferire il keyring di sistema; qui solo per uso locale)
PDFBOOK_API_KEY=

# Solo per "Custom OpenAI-Compatible"
PDFBOOK_BASE_URL=

# Lingua di destinazione: Italiano | Inglese | Spagnolo | Francese | Tedesco
PDFBOOK_TARGET_LANG=Italiano

# Termini da NON tradurre, separati da virgola
PDFBOOK_GLOSSARY=

# INFO | DEBUG | WARNING
PDFBOOK_LOG_LEVEL=INFO

# Percorso della translation memory (fuori dal repository)
PDFBOOK_CACHE_PATH=~/.cache/pdfbook/translations_cache.json

# Endpoint del sidecar OCR/VLM opzionale (vedi docs/architecture/11-unlimited-ocr.md)
PDFBOOK_OCR_URL=

# QA visivo (confronto prima/dopo): 1 = attivo, 0 = disattivato
PDFBOOK_VISUAL_QA=1
PDFBOOK_VISUAL_QA_DPI=72
